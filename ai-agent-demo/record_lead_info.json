    {
      "parameters": {
        "jsCode": "// Loop through all input items\nreturn items.map(item => {\n  const data = item.json;\n\n  // 1. Define required fields\n  const requiredFields = ['full name','company', 'email', 'sector', 'project description'];\n  const missingFields = [];\n\n  // 2. Validate and Clean\n  const cleanData = {};\n  \n  requiredFields.forEach(field => {\n    const value = data[field];\n    \n    // Check if null, undefined, or just empty spaces\n    if (!value || (typeof value === 'string' && value.trim() === \"\")) {\n      missingFields.push(field);\n      cleanData[field] = \"N/A\"; // Fallback value\n    } else {\n      cleanData[field] = typeof value === 'string' ? value.trim() : value;\n    }\n  });\n\n  // 3. Add a validation flag\n  // This helps you use a Filter or If node later to decide if you should actually save it\n  cleanData.isValid = missingFields.length === 0;\n  cleanData.processedAt = new Date().toISOString();\n\n  return { json: cleanData };\n});"
      },
